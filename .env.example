# ReconAI Environment Configuration (Example)
# DO NOT COMMIT ACTUAL SECRETS TO REPOSITORY

# ==========================================
# FRONTEND (Vercel)
# ==========================================
# The API URL where the frontend expects the backend to be hosted.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ==========================================
# BACKEND (Render)
# ==========================================
# Determines operational mode (development | production)
ENVIRONMENT=development

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Server Port (Render sets this automatically)
PORT=8000

# PostgreSQL Connection (Primary database connection)
DATABASE_URL=postgresql://user:password@localhost:5432/reconai

# Supabase specific mapping
SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]

# External Providers (Optional but recommended)
RAZORPAY_KEY_ID=rzp_test_[YOUR_KEY]
RAZORPAY_KEY_SECRET=[YOUR_SECRET]

# AI Provider (Requires at least one)
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
NEMOTRON_API_KEY=[YOUR_NEMOTRON_API_KEY]
